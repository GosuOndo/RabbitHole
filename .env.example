# Copy this file to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL connection string used by Prisma (CLI + runtime).
# Example: postgresql://USER:PASSWORD@localhost:5432/rabbithole?schema=public
DATABASE_URL=

# Optional: fixed anchor date (ISO 8601) for seed timestamps. When unset the seed
# anchors interaction timestamps to the start of the current UTC day, so re-running
# the seed on the same day reproduces identical data.
# SEED_ANCHOR_DATE=2026-08-18T00:00:00.000Z
